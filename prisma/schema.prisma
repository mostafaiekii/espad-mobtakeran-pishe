generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── کاربران (نیروها و مدیر) ─────────────────────────────
model User {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  password   String
  role       String   @default("WORKER") // WORKER | MANAGER
  jobTitle   String? // اپراتور CNC، جوشکار و ...
  hourlyRate Int      @default(0) // نرخ ساعتی (تومان)
  createdAt  DateTime @default(now())

  attendances Attendance[]
  cncJobs     CncJob[]
  advances    AdvanceRequest[]
  tasks       TaskLog[]
  presence    Presence?
}

// ─── حضور و غیاب (ورود / خروج) ───────────────────────────
model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // ENTRY | EXIT
  timestamp DateTime @default(now())
  note      String?
}

// ─── تایم ماشینکاری CNC ──────────────────────────────────
model CncJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  machine     String // نام دستگاه
  partName    String // نام قطعه
  material    String? // جنس
  startTime   DateTime
  endTime     DateTime
  durationMin Int // مدت زمان (دقیقه)
  status      String   @default("DONE") // RUNNING | DONE
  note        String?
  createdAt   DateTime @default(now())
}

// ─── درخواست مساعده ──────────────────────────────────────
model AdvanceRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  amount     Int // مبلغ (تومان)
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ─── چک‌لیست و ثبت کارهای روزانه ─────────────────────────
model TaskLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  category  String   @default("GENERAL") // GENERAL | MAINTENANCE | QUALITY | PACKAGING | SAFETY
  date      DateTime
  status    String   @default("DONE") // TODO | DONE
  note      String?
  createdAt DateTime @default(now())
}

// ─── اطلاعیه‌ها و فایل‌های مدیر برای نیروها ────────────────
model SharedPost {
  id          String           @id @default(cuid())
  title       String
  body        String           @default("")
  createdAt   DateTime         @default(now())
  attachments PostAttachment[]
}

model PostAttachment {
  id        String     @id @default(cuid())
  postId    String
  post      SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String     @default("application/octet-stream")
  size      Int        @default(0)
  data      Bytes
  downloads Int        @default(0)
}

// ─── پایش زنده — هر نیرو الان کدام صفحه برنامه را باز کرده ─
model Presence {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  view      String   @default("attendance") // صفحه فعلی نیرو در برنامه
  userAgent String   @default("")
  updatedAt DateTime @default(now())
}
